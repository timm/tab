-- vim: set ts=2 sw=2 sts=2 et cc=70 :
-- inc.yue: incremental nb + rmeans, scored prequentially.
-- usage: yue inc.yue [name=value | nb | rmeans | acquire | file.csv]
-- (c) 2026 Tim Menzies <timm@ieee.org> MIT license.

local *

abs, exp, floor, huge = math.abs, math.exp, math.floor, math.huge
log, max, min, sqrt = math.log, math.max, math.min, math.sqrt
NUM = {}

the = {bins: 7, fmt: "%.2f", m: 2, p: 2, warm: 10, go: "rmeans"
       few: 128, start: 4, stop: 20, seed: 1234567891
       rng: 1234567891
       test: "None", file: "~/gits/moot/optimize/misc/auto93.csv"}

value = (s) -> tonumber(s) or s\match "^%s*(.-)%s*$"

lt = (a, b) -> a < b

sort = (u, fn) -> table.sort(u, fn) or u

sortBy = (u, fn) ->
  key, was = {}, {}
  key[v], was[v] = fn(v), at for at, v in ipairs u
  sort u, (a, b) ->
    key[a] == key[b] and was[a] < was[b] or key[a] < key[b]

sum = (t, fn) ->
  s = 0
  s += fn v, k for k, v in pairs t
  s

rint = (j) ->
  the.rng = (16807 * the.rng) % 2147483647
  1 + floor(j * the.rng / 2147483647)

shuffle = (u) ->
  u = [v for _, v in ipairs u]
  for j = #u, 2, -1
    k = rint j
    u[j], u[k] = u[k], u[j]
  u

take = (u, j1, j2) -> [v for j,v in ipairs u when j>=j1 and j<=j2]

lines = (file) ->
  path = file\gsub "^~", os.getenv("HOME") or "~"
  f = io.lines path
  -> for line in f
    s = line\match "^%s*(.-)%s*$"
    if s != "" and s\sub(1, 1) != "#"
      return [value v for v in (s .. ",")\gmatch "(.-),"]

-- -------------------------------------------------------------------
Num = (w) -> setmetatable {0, 0, 0, w or 1}, NUM
isNum = (col) -> getmetatable(col) == NUM
Col = (txt) ->
  txt\find("^%u") and Num(txt\find("%-$") and 0 or 1) or {}

add = (col, v, inc = 1) ->
  return col if v == "?"
  unless isNum col
    c = (col[v] or 0) + inc
    col[v] = c > 0 and c or nil
    return col
  if col[1] + inc <= 0
    col[1], col[2], col[3] = 0, 0, 0
  else
    col[1] += inc
    d = v - col[2]
    col[2] += inc * d / col[1]
    col[3] += inc * d * (v - col[2])
  col

n = (col) -> isNum(col) and col[1] or sum(col, (v) -> v)

div = (num) -> num[1] < 2 and 0 or sqrt max(num[3],0) / (num[1]-1)

norm = (col, v) ->
  return v if v == "?" or not isNum col
  z = (v - col[2]) / (div(col) + 1e-32)
  1 / (1 + exp(-1.7 * max(-3, min(3, z))))

bin = (col, v) ->
  return v if v == "?" or not isNum col
  min the.bins, 1 + floor(the.bins * norm(col, v))

argmax = (t, fn) ->
  local out
  b = -huge
  for _, k in ipairs sort([k for k in pairs t], (x, y) ->
                          tostring(x) < tostring(y))
    v = fn k
    b, out = v, k if v > b
  out

mid = (col) -> isNum(col) and col[2] or argmax(col, (k) -> col[k])

mids = (tab) ->
  u = {}
  u[at] = mid tab.cols[at] for at = 1, #tab.cols
  u

nvals = (col) -> isNum(col) and the.bins or max 2, sum(col, -> 1)

-- -------------------------------------------------------------------
Tab = (names, rows) ->
  tab = {:names, rows: {}, cols: {}, x: {}, y: {}}
  for at, txt in ipairs names
    tab.cols[at] = Col txt
    continue if txt\find "X$"
    u = txt\find("[-+!]$") and tab.y or tab.x
    u[#u + 1] = at
    tab.klass = at if txt\find "!$"
  addRow tab, row for _, row in ipairs rows or {}
  tab

addRow = (tab, row, inc = 1, keep = true) ->
  tab.rows[#tab.rows + 1] = row if keep and inc > 0
  tab.cols[at] = add tab.cols[at], row[at], inc for at = 1, #tab.cols
  row

ydist = (tab, row) ->
  c = tab.cols
  f = (at) -> abs(norm(c[at], row[at]) - c[at][4]) ^ the.p
  (sum(tab.y, f) / #tab.y) ^ (1 / the.p)

xdist = (tab, r1, r2) ->
  d = 0
  for _, at in ipairs tab.x
    a, b, col = r1[at], r2[at], tab.cols[at]
    if a == "?" and b == "?"
      d += 1
    elseif not isNum col
      d += a == b and 0 or 1
    else
      a, b = norm(col, a), norm(col, b)
      a = b > .5 and 0 or 1 if a == "?"
      b = a > .5 and 0 or 1 if b == "?"
      d += abs(a - b) ^ the.p
  (d / #tab.x) ^ (1 / the.p)

update = (model, row) ->
  t = model.tab
  t.cols[at] = add t.cols[at], row[at] for at = 1, #t.cols
  y = model.want row
  return if y == "?"
  model.caught y
  for _, at in ipairs t.x
    b = bin t.cols[at], row[at]
    model.add1 at, b, y if b != "?"

err = (model, row) ->
  want, got = model.want(row), model.guess row
  return "?" if want == "?" or got == nil
  model.loss want, got

-- -------------------------------------------------------------------
learn = (make) ->
  local m, post
  pre, j = Num!, 0
  for row in lines the.file
    j += 1
    if j == 1
      m = make row
    else
      pre = add pre, err(m, row) if j > the.warm + 1
      update m, row
  if the.test and the.test != "None"
    post, j = Num!, 0
    for row in lines the.test
      j += 1
      post = add post, err(m, row) if j > 1
  m, pre, post

Nbi = (names) ->
  nb = {tab: Tab(names), subs: {}}
  nb.want = (row) -> row[nb.tab.klass]
  nb.caught = ->
  nb.add1 = (at, b, k) ->
    nb.subs[k] or= {j, {} for _, j in ipairs nb.tab.x}
    add nb.subs[k][at], b
  nb.like = (k, sub, row) ->
    kl = nb.tab.cols[nb.tab.klass]
    s = log(((kl[k] or 0) + the.m) / (n(kl) + the.m * nvals(kl)))
    for _, at in ipairs nb.tab.x
      v = row[at]
      if v != "?"
        col = nb.tab.cols[at]
        s += log(((sub[at][bin(col, v)] or 0) + the.m) /
                 (n(sub[at]) + the.m * nvals(col)))
    s
  nb.guess = (row) -> next(nb.subs) and
    argmax(nb.subs, (k) -> nb.like k, nb.subs[k], row) or nil
  nb.loss = (want, got) -> want == got and 0 or 1
  nb

Rmi = (names) ->
  rm = {tab: Tab(names), has: {}}
  ys = rm.tab.y
  rm.goal = #ys == 1 and isNum(rm.tab.cols[ys[1]]) and ys[1] or nil
  rm.all = not rm.goal and Num! or nil
  rm.want = (row) ->
    rm.goal and row[rm.goal] or ydist rm.tab, row
  rm.caught = (y) -> rm.all = add(rm.all, y) unless rm.goal
  rm.tot = -> rm.goal and rm.tab.cols[rm.goal] or rm.all
  rm.add1 = (at, b, y) ->
    t = rm.has[at] or {}
    rm.has[at] = t
    t[b] = add (t[b] or Num!), y
  rm.like = (at, row) ->
    bins, tot = rm.has[at], rm.tot!
    v = bins and bins[bin rm.tab.cols[at], row[at]]
    return unless v
    w = div(tot) ^ 2 - sum bins, (u) -> u[1] / tot[1] * div(u) ^ 2
    if w > 0
      (v[1] * v[2] + the.m * tot[2]) / (v[1] + the.m), w
  rm.guess = (row) ->
    tot = rm.tot!
    return nil if tot[1] == 0
    s, w = 0, 0
    for _, at in ipairs rm.tab.x
      g, wt = rm.like at, row
      s, w = s + wt * g, w + wt if g
    w > 0 and s / w or tot[2]
  rm.loss = (want, got) -> abs got - want
  rm

-- -------------------------------------------------------------------
acquire = (tab, cap) ->
  cap or= the.stop
  todo = take shuffle(tab.rows), 1, the.few
  kid = (rows) -> Tab tab.names, rows
  both = kid [table.remove todo for _ = 1, the.start]
  sortBy both.rows, (r) -> ydist both, r
  k = floor the.start ^ .5
  best = kid take both.rows, 1, k
  rest = kid take both.rows, k + 1, huge
  while #todo > 0 and #both.rows < cap
    rmid, bmid = mids(rest), mids(best)
    sortBy todo, (z) -> xdist(tab, z, rmid) - xdist(tab, z, bmid)
    addRow best, addRow(both, table.remove todo)
    sortBy best.rows, (r) -> ydist both, r
    if #best.rows > (#both.rows) ^ .5
      addRow rest, addRow(best, table.remove(best.rows), -1, false)
  both.rows

acq = ->
  src = [row for row in lines the.file]
  tab = Tab src[1], take(src, 2, huge)
  ys = (rows) ->
    u = sort [ydist(tab, r) for _, r in ipairs rows], lt
    s = 0
    s += v for _, v in ipairs u
    "%s/%s"\format fmt(u[1]), fmt(s / #u)
  got = acquire tab
  rand = ys take shuffle(tab.rows), 1, #got
  print ":acquire %s n=%s best=%s rand=%s all=%s"\format(
        the.file, #got, ys(got), rand, ys tab.rows)

fmt = (x) ->
  x == floor(x) and tostring(floor x) or the.fmt\format x

report = (what, pre, post) ->
  print ":prequential %s n=%s %s=%s"\format the.file, pre[1], what,
        fmt pre[2]
  if post
    print ":frozen %s n=%s %s=%s"\format the.test, post[1], what,
          fmt post[2]

slow = {
  nb: -> report "err", select 2, learn Nbi
  rmeans: -> report "mae", select 2, learn Rmi
  acquire: acq}

cli = ->
  for _, s in ipairs arg or {}
    k, v = s\match "^(%a[%w_]*)=(.*)$"
    if k
      the[k] = value v
    elseif slow[s]
      the.rng = the.seed
      slow[s]!
    else
      the.file = s
  the

main = (arg and arg[0]) or ""
if main\find("inc%.yue$") or main\find("inc%.lua$")
  the.rng = cli!.seed
  slow[the.go]! if slow[the.go]

setmetatable {
    :the, :slow, :NUM
    :Num, :isNum, :Col, :add, :n, :div, :norm, :bin, :mid, :mids
    :nvals, :argmax
    :Tab, :addRow, :ydist, :xdist, :update, :err
    :learn, :Nbi, :Rmi, :acquire, :acq
    :value, :lt, :sort, :sortBy, :sum, :rint, :shuffle, :take, :lines
    :fmt, :report, :cli
  }, {__index: _G}
