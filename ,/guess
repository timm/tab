#!/usr/bin/env bash
# guess: an LLM guesses each function's true signature, cached. usage: ,/guess [f.lua ...]
cd "$(git rev-parse --show-toplevel)" || exit 1
[ $# -gt 0 ] && files=("$@") || files=(tab.lua tab-eg.lua)
out=$HOME/tmp/guesses.txt; mkdir -p "$HOME/tmp"
if [ -s "$out" ] && [ -z "$(find "${files[@]}" -newer "$out" 2>/dev/null)" ]
then echo "$out: fresh (to force, rm it)" >&2; exit 0; fi

prompt='This is lua. House style: in a function declaration, any
parameters after a run of two or more spaces are scratch locals, not
real parameters. For every top-level function declaration, print one
line, two tab-separated fields: the full dotted function name, then
its derived signature with each real parameter annotated with its
type: the class names used here (TAB, NUM, SYM, BINS, RMEANS, NB,
BAG, SAME) or num, int, str, bool, list, fun, file. Then -> a short
guess at the return type (omit if none). Infer types from how each
value is used; prefer the class names over generic types whenever a
value is an instance of one. When the body gives a parameter a
default (idioms like x = x or 4, or a value pulled from the config
table "the"), show it: name(p:type=default). Plain text, no
headers, no fences, no other text.
Example:  SAME.cohen	SAME.cohen(i:SAME, d:num=.35) -> num'

ask() {                        # api direct if a key is in the env;
  if [ -n "$ANTHROPIC_API_KEY" ]   # else the cli, sans mcp startup
  then PROMPT="$prompt" python3 -c '
import json, os, sys, urllib.request
r = urllib.request.Request("https://api.anthropic.com/v1/messages",
  data=json.dumps({"model": "claude-haiku-4-5-20251001",
    "max_tokens": 4096, "system": os.environ["PROMPT"],
    "messages": [{"role": "user", "content": sys.stdin.read()}]}).encode(),
  headers={"x-api-key": os.environ["ANTHROPIC_API_KEY"],
    "anthropic-version": "2023-06-01", "content-type": "application/json"})
print(json.load(urllib.request.urlopen(r))["content"][0]["text"])'
  else claude -p --model "${MODEL:-haiku}" \
         --strict-mcp-config --mcp-config='{"mcpServers":{}}' "$prompt"
  fi; }

echo "asking claude; seconds to a minute..." >&2
cat "${files[@]}" | ask | awk -F'\t' 'NF == 2' > "$out"
wc -l "$out"
