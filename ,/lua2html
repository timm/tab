#!/usr/bin/env bash
# lua2html: pycco the lua into docs/.  usage: ./lua2html
# A comment trailing a function moves above it first (etc/hoist.awk),
# since pycco reads only a whole-line comment as prose.  The temp copy
# keeps each file's name: tab.lua's main guard tests arg[0] for it.
cd "$(git rev-parse --show-toplevel)" || exit 1
tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT
for f in tab.lua tab-eg.lua; do
  awk -f etc/hoist.awk "$f" > "$tmp/$f" || exit 1; done
pycco -d docs "$tmp"/*.lua
touch docs/.nojekyll            # serve the html as-is, no liquid
ls -l docs/*.html docs/pycco.css
