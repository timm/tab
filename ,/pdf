#!/usr/bin/env bash
# pdf: x.lua ==> ~/tmp/x.pdf, pretty-printed, 3-up landscape.
# usage: ,/pdf file.lua [file.py ...]
#   Font=4.5   font size (flow mode default)
#   Chars=65   wrap width.  a2ps DERIVES the font size from this, so
#              Chars and Font fight and Chars wins: setting both is
#              the same as setting Chars alone.  Pick one.
#   Lines=118  column-aligned mode: a ^L at the END of a line jumps
#              to the top of the next column of Lines rows; without
#              Lines, ^Ls are stripped and the text just flows.
# a2ps splits option values on commas, so styles are installed into
# a2ps's own library by name, then asked for by name: lua for .lua,
# yue for .yue, python for .py (a2ps ships that one), def for
# anything else.  .yue needs its own sheet: yuescript has no
# `function` and no `end`, so lua.ssh's label rule never fires.
Here="$(cd "$(dirname "$0")/.." && pwd)"
Dir=$(a2ps --list=defaults 2>/dev/null \
      | awk '/library path/{getline; print $1; exit}')
[ -n "$Dir" ] || { echo "no a2ps" >&2; exit 1; }
mkdir -p "$Dir" ~/tmp
for s in lua yue def; do
  [ "$Here/etc/$s.ssh" -nt "$Dir/$s.ssh" ] &&
    cp "$Here/etc/$s.ssh" "$Dir/$s.ssh"; done
for f in "$@"; do
  out=~/tmp/$(basename "${f%.*}").pdf
  style=def
  case "$f" in
    *.lua) style=lua;; *.yue) style=yue;; *.py) style=python;;
  esac
  L=$Lines                             # a file with ^L in it gets
  [ -z "$L" ] && grep -q "" "$f" &&         # column mode: fit the
    L=$(awk 'BEGIN{RS="\f"}                    # biggest ^L segment
             {n=split($0,a,"\n"); if(n>m)m=n} END{print m+1}' "$f")
  F=$Font; [ -z "$L" ] && : "${F:=4.5}"
  src="$f"; [ -z "$L" ] && src=/dev/stdin
  a2ps -Br --quiet --landscape --pro=color             \
       ${L:+-L $L} ${F:+--font-size=$F}  \
       ${Chars:+--chars-per-line=$Chars}               \
       --line-numbers=1 --borders=no --columns=3       \
       -M letter --pretty-print=$style -o -            \
       --stdin="$(basename "$f")" "$src"               \
       < <(tr -d '\f' < "$f")                          \
    | ps2pdf - "$out" && echo "$out" && open "$out"
done
