#!/usr/bin/env bash
# sh: a work shell for tab. usage: ,/sh
Here="$(cd "$(dirname "$0")/.." && pwd)"
export MOOT=${MOOT:-$HOME/gits/moot}
# experiments belong next door (see CLAUDE.md), so if the sibling
# repo is there, scores go to it rather than to ~/tmp
Dev="$(cd "$Here/../tab-dev" 2>/dev/null && pwd)"
export CACHE=${CACHE:-${Dev:+$Dev/cache}}
export CACHE=${CACHE:-$HOME/tmp/cache}
export PATH="$Here/,:$PATH"
exec bash --init-file <(cat <<EOF
[ -f ~/.bashrc ] && . ~/.bashrc
cd "$Here"
alias t='luajit tab.lua'
alias eg='luajit tab-eg.lua'
alias vi='nvim --clean -u "$Here/etc/nviminit.lua"'
alias ..='cd ..'
if ls --color=auto . >/dev/null 2>&1   # gnu coreutils, or busybox
then Ls='ls --color=auto'
else Ls='ls -G'; export CLICOLOR=1     # bsd, which macos ships
     export LSCOLORS=ExGxFxdaCxDaDahbadacec
fi
alias ls="\$Ls"
alias l="\$Ls -lh"
alias ll="\$Ls -lhA"
alias gs='git status -sb'
alias gd='git diff --stat'
HISTCONTROL=ignoredups:erasedups
shopt -s histappend checkwinsize
. "$Here/etc/prompt.bash"
C=\$(tput setaf 6 2>/dev/null); G=\$(tput setaf 2 2>/dev/null)
D=\$(tput setaf 8 2>/dev/null); R=\$(tput sgr0 2>/dev/null)
echo ""
echo " \${C}    _______  \${G}t a b\${R}"
echo " \${C}   /      /,  \${D}tables, learned from, in lua\${R}"
echo " \${C}  /      //\${R}"
echo " \${C} /______//\${R}"
echo " \${C}(______(/\${R}"
echo ""
"$Here/,/help"
echo ""
EOF
)
