#!/usr/bin/env bash
# sig: each function's derived signature. usage: ,/sig [f.lua ...]
# No LLM: returns come from the source's "--> type", parameters from
# their names.  See etc/sig.awk.
cd "$(git rev-parse --show-toplevel)" || exit 1
[ $# -gt 0 ] && files=("$@") || files=(tab.lua tab-eg.lua)
gawk -f etc/sig.awk "${files[@]}"
