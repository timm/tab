#!/usr/bin/env bash
# md: lua in, literate markdown out; and every page's banner, in.
# usage: ./md [file.lua ...]     (no arguments: do the lot)
#
# README holds the one copy of the logo and the menubar, with links
# written from the root.  A page's banner is everything above its
# first "# title", so README's banner is everything above "# tab".
# Every other page gets that same block, re-aimed at where that page
# sits, so changing the menu means changing README and running this.
cd "$(git rev-parse --show-toplevel)" || exit 1
grep -q '^<<<<<<< ' README.md &&                 # else the markers
  { echo "README.md has conflict markers"; exit 1; }   # go everywhere
head -1 README.md | grep -q '^# ' &&             # else the banner is
  { echo "README.md starts with its title; move it below the menubar";
    exit 1; }                                    # the whole file
[ $# -gt 0 ] && files=("$@") || files=(tab.lua tab-eg.lua)

banner() {                      # the banner, aimed at directory $1
  gawk 'BEGIN {RS = "\n# "}     # so record one is all above the title
        {sub(/\n+$/, ""); print $0 "\n"; exit}' README.md |
  case "$1" in
    .)    cat ;;                               # root: as written
    docs) sed 's|](docs/|](|g; s|src="docs/|src="|g';;
    *)    sed 's|](|](../|g; s|src="|src="../|g';;      # one level down
  esac; }

SIGS=$(mktemp); export SIGS; trap 'rm -f "$SIGS"' EXIT  # signatures,
gawk -f etc/sig.awk "${files[@]}" > "$SIGS"      # derived, for lit.awk

for f in "${files[@]}"; do      # the literate source
  b=$(basename "$f" .lua)
  { printf '# %s\n\n' "$f"; gawk -f etc/lit.awk "$f"; } > "docs/$b.md"; done

for f in README.md LICENSE.md docs/*.md; do     # the banner
  [ "$f" = README.md ] && continue
  body=$(gawk 'f || /^# / {f = 1; print}' "$f")
  [ -z "$body" ] && { echo "$f: no '# title' line, skipped" >&2; continue; }
  { banner "$(dirname "$f")"; printf '%s\n' "$body"; } > "$f.new" &&
    mv "$f.new" "$f"; done
ls -l docs/*.md
